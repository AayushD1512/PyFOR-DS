    "def httpCode(code):\n",
    "    match code:\n",
    "        case \"200\":\n",
    "            return \"OK\"\n",
    "        case \"400\":\n",
    "            return \"Bad request\"\n",
    "        case \"404\":\n",
    "            return \"Page Note Found\"\n",
    "        case _:\n",
    "            return \"Unknown error\""
   ]
