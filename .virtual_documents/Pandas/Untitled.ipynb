import pandas as pd


data = {
    'Name': ['Alice', 'Bob', 'Charlie'],
    'Math': [85, 78, 92],
    'Science': [90, 82, 89],
    'English': [88, 85, 94]
}



df = pd.DataFrame(data)
df


df = df.melt(id_vars=["Name"], value_vars=["Math", "Science", "English"], var_name="Subject", value_name="Score")


df


df2 = df.copy()


df2


df2 = df2.pivot_table(index="Name", columns="Subject", values="Score", aggfunc="mean")


df2.columns.name = None


df2



