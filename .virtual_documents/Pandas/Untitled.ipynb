import pandas as pd


df = pd.DataFrame({
    "Department": ["HR", "HR", "IT", "IT", "Marketing", "Marketing", "Sales", "Sales"],
    "Team": ["A", "A", "B", "B", "C", "C", "D", "D"],
    "Gender": ["M", "F", "M", "F", "M", "F", "M", "F"],
    "Salary": [85, 90, 78, 85, 92, 88, 75, 80],
    "Age": [23, 25, 30, 21, 28, 26, 21, 27],
    "JoinDate": pd.to_datetime([
        "2020-01-10", "2020-02-15", "2021-03-20", "2021-04-10",
        "2020-05-30", "2020-06-25", "2021-07-15", "2021-08-01"
    ])
})  



df


df.groupby("Department")["Salary"].mean()


df.groupby(["Team", "Gender"])["Salary"].min()


df.groupby("Age")["Salary"].agg([
    "mean",
    "sum",
    "max"
])


df.groupby("Age")["Salary"].agg(
    avgSalary="mean",
    totalSalary="sum",
    MaxCurrSalary="max"
)


df.groupby("Team").agg({
    "Salary": "mean",
    "Age": "max"
})


df


df["Team Avg"] = df.groupby("Team")["Salary"].transform("mean") #take Teams then calc avg of salaries for teams and then new row


df


df2 = df.groupby("Department").filter(lambda x: x["Salary"].mean() > 85)



