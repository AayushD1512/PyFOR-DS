import matplotlib.pyplot as plt


labels = ["Sachin", "Sehwag", "Kohli", "Yuvraj"]
runs = [18000, 8000, 12000, 9500]
colors = ['#ff9999','#66b3ff','#99ff99','#ffcc99']


# Simple Pie Chart


plt.pie(runs, labels=labels, colors=colors)


plt.pie(
    runs, 
    labels=labels, 
    colors=colors,
    wedgeprops={'edgecolor':'black', 'linewidth':2, 'linestyle':'--'}
)


#3D area AND SHADOW

explode = [0.15, 0, 0, 0]

plt.pie(
    runs, 
    labels=labels, 
    colors=colors,
    wedgeprops={'edgecolor':'black', 'linewidth':2, 'linestyle':'-'},
    explode=explode,
    shadow=True
)


#showing percentage

#3D area AND SHADOW

explode = [0.15, 0, 0, 0]

plt.pie(
    runs, 
    labels=labels, 
    colors=colors,
    wedgeprops={'edgecolor':'black', 'linewidth':2, 'linestyle':'-'},
    explode=explode,
    shadow=True,
    autopct='%1.2f%%'
)


languages = ['Python', 'Java', 'C++', 'JavaScript', 'C#', 'Ruby', 'Go', 'Rust', 'Swift', 'PHP']
usage = [30, 20, 10, 10, 7, 5, 4, 3, 2, 1]


#trying above with bar charts h and v

plt.bar(languages, usage, label=languages)


plt.barh(usage, languages, label=languages)



